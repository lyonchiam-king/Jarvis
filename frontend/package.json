{
  "name": "outreach-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The React front end for the Jarvis outreach dashboard. Built to static files and served by the Flask app in src/outreach/, so there is no Node server here and none in production.",
