# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Google Places API (New) ---
# Cloud Console > APIs & Services > Credentials > API key
# Requires "Places API (New)" enabled AND an active billing account.
PLACES_API_KEY=

# --- Google Sheet ---
# Leave blank on first run: `outreach init-sheet` creates the spreadsheet
# and prints the ID for you to paste here.
SHEET_ID=

# --- OAuth (Sheets + Gmail) ---
# Path to the "Desktop app" OAuth client JSON downloaded from Cloud Console.
GOOGLE_OAUTH_CLIENT_FILE=credentials/oauth_client.json
# Written automatically after the first browser consent. Gitignored.
GOOGLE_TOKEN_FILE=credentials/token.json

# --- Claude API (Stage 2 research briefs, and outreach copy later) ---
# Required for `outreach run research`. Not needed for Stage 1 discovery.
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# --- Using a different model -------------------------------------------------
# Set research.provider in your campaign file, then fill in the matching key.
#   provider: ollama            -> runs on this machine, no key needed
#   provider: ollama-cloud      -> OLLAMA_API_KEY below
#   provider: openrouter        -> OPENROUTER_API_KEY below
#   provider: gemini            -> GEMINI_API_KEY below (aistudio.google.com/apikey)
# Only Anthropic guarantees the reply matches the schema; the others are
# validated and retried once, then the lead is skipped. See DAILY.md.
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# For provider: openai-compatible, if that endpoint needs a key.
LLM_API_KEY=

# --- Active campaign ---
CAMPAIGN_CONFIG=config/campaigns/penang-my.yaml

# Cloudflare Pages, for publishing the built sites.
# Token: dash.cloudflare.com > My Profile > API Tokens, with the
# "Cloudflare Pages: Edit" permission. Account id is in the dashboard URL.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
